# Environment variables template for SkillBridge
# Copy this file to .env and adjust values for your local environment.

# PostgreSQL Connection String (Neon PostgreSQL with connection pooling recommended for Vercel)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"

# Authentication secret for signing session cookies
# Generate with: openssl rand -base64 32 (minimum 32 characters required in production)
AUTH_SECRET="your-32-character-secret-key-here"

# Supabase Storage Configuration (Private File Bucket: skillbridge-files)
# Supabase project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Key (Server-side ONLY. NEVER expose with NEXT_PUBLIC_ or send to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Production Application URL (Optional in dev, recommended in production for CSRF and canonical links)
# Example: https://skillbridge.vercel.app or https://your-domain.com
APP_URL="https://your-production-domain.example"
